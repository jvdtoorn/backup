# Allow list for backup.sh: the hidden files and folders (names starting with
# ".") that ARE copied. Every other hidden file or folder is skipped.
# Regular (non-hidden) files are governed by backup.ignore instead.
#
# One entry per line; "#" starts a comment line. Syntax:
#   .gitignore      a file or folder with this name, at any depth
#   /.zsh_history   only directly in the source folder (leading "/")
#   .git/           a folder; everything inside it is kept (trailing "/")
#   .env*           wildcards work
#   /.local/bin/    a folder deeper down: only that subtree is kept
#                   (needs the leading "/")
#
# The last form turns its parent into a KEEP-ONLY area: the parent folder is
# walked, the listed subtree is kept, and everything else in that parent is
# skipped. That is how ~/Library and the mixed tool folders (~/.gradle, ~/.m2)
# are handled: list what is worth keeping, the rest falls away by itself.
# Careful: a name that is allowed at ANY depth (.cargo/, .cursor/) cannot be
# trimmed this way, because the any-depth rule also matches the copy in ~.
# Those are trimmed from backup.ignore instead, which wins over this file.
#
# Rule order inside backup.sh: ignore list, then these allows, then the
# keep-only catch-alls, then "skip every other hidden name". Changing that
# order silently breaks the backup.
#
# Heads-up: this list deliberately keeps files that can hold secrets (.netrc,
# .pypirc, .env*, .aws, .gnupg, .kube, .ssh, Keychains, .zsh_history). Keep the
# backup disk safe.

# ---------------------------------------------------------------------------
# Shell config. Allowed at any depth on purpose: if ~/.zshrc and ~/.gitconfig
# are symlinks into a dotfiles repository, the real files live in a subfolder.
# ---------------------------------------------------------------------------
.zshrc*
.zshenv*
.zprofile*
.zlogin
.zlogout
.bashrc*
.bash_profile*
.bash_login
.bash_logout
.profile
.kshrc
.inputrc
.aliases
.functions
.p10k.zsh
/.zsh_history
/.bash_history
/.sshrc
/.hushlogin
/.tmux.conf
/.screenrc
/.nanorc
/.wezterm.lua
/.alacritty.yml
/.alacritty.yaml
/.alacritty.toml

# ---------------------------------------------------------------------------
# Git files (the .git/ folder itself is under "Folders" below)
# ".git" without a slash is on purpose: a linked worktree or a submodule
# stores a .git FILE, not a folder.
# ---------------------------------------------------------------------------
.git
.gitignore
.gitattributes
.gitmodules
.gitconfig
.gitmessage
.gitkeep
.mailmap
.git-blame-ignore-revs
/.gitconfig-*
/.git-credentials
/.gitignore_global

# ---------------------------------------------------------------------------
# Environment and secrets. Recoverability wins here; see the warning above.
# ---------------------------------------------------------------------------
.env
.env.*
.envrc
.sops.yaml
.sops.yml
/.direnvrc

