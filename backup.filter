# rsync filter rules for backup.sh. Paths are relative to your home folder.
#
# Everything under ~ is backed up unless a rule below excludes it.
# First matching rule wins. A leading "/" anchors the rule to the top of ~,
# a trailing "/" only matches directories.
#
# Tweak this file using the extensions CSV in logs/: anything in there that you
# don't want, exclude here (e.g. "- *.log"), then run the script again.
# Files that were already copied stay in the backup, since nothing is deleted.

# ---------------------------------------------------------------------------
# custom ignores: not worth recovering at this time
# ---------------------------------------------------------------------------
- *.agent
- *.log
- *.lock
- *.tsbuildinfo
- *.hbc
- *.xcsettings
- *.opf
- /.flutter
- /.yarnrc
- /.rm-safely
- /.sentryclirc
- /.mailcap
- *.bundle
- *.types
- *.pkl
- *.db
- .wakeup


# ---------------------------------------------------------------------------
# macOS junk
# ---------------------------------------------------------------------------
- .DS_Store
- ._*
- .localized
- /.CFUserTextEncoding

# ---------------------------------------------------------------------------
# Regenerable build output and dependency folders, anywhere in the tree
# ---------------------------------------------------------------------------
- node_modules/
- __pycache__/
- *.pyc
- venv/
- Pods/
# Uncomment if you never keep hand-made files in folders with these names:
- build/
- dist/
- target/

# ---------------------------------------------------------------------------
# Top-level folders in ~
# ---------------------------------------------------------------------------
# App bundles and app data (reinstall / re-sync instead)
- /Library/
- /Applications/
- /Applications (Parallels)/
# Virtual machines: 44G, comment out to keep them
- /Parallels/
# Empty mount points for network drives
- /Drives/

# ---------------------------------------------------------------------------
# Shell files in ~ (.zsh_history and .bash_history are kept on purpose)
# ---------------------------------------------------------------------------
- /.zcompdump*
- /.lesshst
- /.viminfo
- /.node_repl_history
- /.python_history
- /.rm-safely-undo-stack

# ---------------------------------------------------------------------------
# Hidden folders and numbered dotfiles
# ---------------------------------------------------------------------------
# Skip every folder whose name starts with ".", at any depth (.git, .config,
# .codex, .venv, ...) without listing them. Exceptions must come first, since
# the first matching rule wins.
# ~/.ssh: keep keys and config, skip what ssh recreates itself
- /.ssh/known_hosts*
- /.ssh/agent/
+ /.ssh/***
# To only skip hidden folders directly in ~, use "- /.*/" instead.
- .*/

# Dotfiles named after a number (.1, .23, ... of any length) are skipped by
# backup.sh itself, right after all rules in this file, except the .42 directly
# in the top folder. That rule is hardcoded in the script because rsync patterns
# can't say "one or more digits".
